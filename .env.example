# ---- Web server ----
PORT=3000
HOST=0.0.0.0
# Set to 1 (or a subnet) when running behind a reverse proxy / load balancer.
TRUST_PROXY=

# ---- Login (HTTP Basic auth) ----
# Comma-separated user:password pairs. Required unless AUTH_DISABLED=true.
APP_USERS=admin:change-me
# Only for local development. Never disable auth on a reachable server.
AUTH_DISABLED=false

# ---- PostgreSQL (the database that holds message_processing_logs etc.) ----
DATABASE_URL=postgres://user:password@db-host:5432/database
# '' (no TLS), 'require' (TLS + verify certificate) or 'no-verify' (TLS, skip verification)
PGSSL=
# Schema that contains the tables (default public)
DB_SCHEMA=public
PG_POOL_MAX=10

# Time zone used for the dashboard's hourly/daily buckets when the browser does not send one.
DEFAULT_TZ=Asia/Bangkok

# ---- CPI connection (optional: lets this server sync the keystore and/or poll MPLs itself) ----
# Not needed when n8n fills the database.
# e.g. https://<tenant>.it-cpi012.cfapps.ap21.hana.ondemand.com/api/v1
CPI_API_URL=
# OAuth2 client credentials from the CPI service key (tokenurl / clientid / clientsecret)
CPI_TOKEN_URL=
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=

# If this server reaches the internet through a proxy (company network):
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1,db-host
# If a company proxy re-signs TLS traffic, trust its root CA:
# NODE_EXTRA_CA_CERTS=/etc/ssl/company-root-ca.pem

# ---- Certificate expiry ----
CERT_CRITICAL_DAYS=30
CERT_WARN_DAYS=90
# Warn when the last keystore sync (n8n or this app) is older than this
CERT_STALE_HOURS=26
# Only with a CPI connection on this server: how often the app itself syncs the keystore
CERT_SYNC_INTERVAL_MINUTES=360

# ---- Ticket pulse (Freshservice tickets filled by the n8n workflow "FreshServices Tickets") ----
TICKETS_TABLE=tickets
# Link to a ticket (this is the default); {number} = digits of INC-123, {id} = the whole id; off = no links
TICKET_URL=https://itservice.thaiunion.com/a/tickets/{number}
TICKETS_DUE_SOON_HOURS=72
TICKETS_STALE_HOURS=24

# ---- Optional: pull CPI error MPLs directly (replaces the n8n "CPI MPL Errors → Postgres" workflow) ----
# Uses the CPI connection above.
CPI_POLL_ENABLED=false
CPI_POLL_INTERVAL_MINUTES=60
CPI_POLL_LOOKBACK_HOURS=24
CPI_POLL_STATUSES=FAILED,RETRY,ESCALATED

# ---- Kanban cards from errors (TodoList Kanban app, over MCP) ----
# Leave KANBAN_MCP_URL empty to hide the "Create Kanban card" button.
# MCP endpoint of the Kanban app (Streamable HTTP), e.g. https://kanban.example.com/mcp
KANBAN_MCP_URL=
# API key of the Kanban app; sent as "Authorization: Bearer <key>"
KANBAN_MCP_TOKEN=
# Set when the key goes in another header (e.g. X-API-Key); the key is then sent as is
KANBAN_MCP_AUTH_HEADER=Authorization
# Board id or title (empty = the first board the key can see)
KANBAN_BOARD=TUIP
# Defaults for new cards (the user can change them before creating the card)
KANBAN_COLUMN=To do
KANBAN_LABELS=Monitoring
KANBAN_PRIORITY=medium
# Optional link to a card in the Kanban app; {id} = card id
KANBAN_CARD_URL=
