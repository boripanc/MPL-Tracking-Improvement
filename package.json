{
  "name": "cpi-error-center",
  "version": "1.1.1",
  "description": "Dashboard and knowledge base for SAP CPI message processing log (MPL) errors, backed by PostgreSQL.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "poll": "node src/scripts/poll-once.js",
    "db:init": "node src/scripts/init-db.js",
    "db:seed": "node src/scripts/init-db.js --seed",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "chart.js": "4.4.1",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "pg": "8.13.1"
  }
}
